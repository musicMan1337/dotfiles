{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_WORKFLOWS": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "allow": [
      "Bash(*)",
      "Read(**)",
      "Edit(**)",
      "Write(**)",
      "Grep(**)",
      "Glob(**)",
      "WebSearch",
      "WebFetch(*)",
      "Skill(*)",
      "mcp__exa__*",
      "mcp__rag__*",
      "mcp__agentic-coding-school__*",
      "mcp__claude-in-chrome__*",
      "mcp__context7__*",
      "mcp__sql-server__*",
      "mcp__claude_ai_Fathom__*",
      "mcp__claude_ai_HubSpot__*",
      "mcp__claude_ai_Microsoft_365__*",
      "mcp__plugin_playwright_playwright__*",
      "mcp__plugin_splunk-mcp-plugin_splunk-mcp__*",
      "mcp__plugin_viper-stage-plugin_viper-stage__*"
    ],
    "deny": [
      "Bash(sudo *)",
      "Bash(rm -rf /)",
      "Bash(rm -rf /*)",
      "Bash(dd *)",
      "Bash(diskutil erase*)",
      "Bash(diskutil partitionDisk*)",
      "Bash(shutdown*)",
      "Bash(reboot*)",
      "Read(**/dist/**)",
      "Read(**/build/**)",
      "Read(**/.next/**)",
      "Read(**/out/**)",
      "Read(**/*.lock)",
      "Read(**/pnpm-lock.yaml)",
      "Read(**/yarn.lock)"
    ]
  },
  "model": "opus[1m]",
  "skillOverrides": {
    "spec:advisor": "user-invocable-only",
    "spec:audit": "user-invocable-only",
    "spec:compound": "user-invocable-only",
    "spec:developer": "user-invocable-only",
    "spec:implement": "user-invocable-only",
    "vuln:fix": "user-invocable-only",
    "vuln:scan": "user-invocable-only",
    "vuln:setup": "user-invocable-only",
    "splunk:core": "user-invocable-only",
    "splunk:sql": "user-invocable-only",
    "splunk:truffle": "user-invocable-only",
    "splunk:viper": "user-invocable-only",
    "setup:ci": "user-invocable-only",
    "setup:linting": "user-invocable-only",
    "setup:sub-agent-config": "user-invocable-only",
    "setup:package-lockdown": "user-invocable-only",
    "setup:package-lockdown:_refs:anti-patterns": "user-invocable-only",
    "setup:package-lockdown:_refs:bootstrap-day-zero": "user-invocable-only",
    "setup:package-lockdown:_refs:case-studies": "user-invocable-only",
    "setup:package-lockdown:_refs:ci-stack": "user-invocable-only",
    "setup:package-lockdown:_refs:ecosystem-actions": "user-invocable-only",
    "setup:package-lockdown:_refs:ecosystem-cli-binaries": "user-invocable-only",
    "setup:package-lockdown:_refs:ecosystem-docker": "user-invocable-only",
    "setup:package-lockdown:_refs:ecosystem-go": "user-invocable-only",
    "setup:package-lockdown:_refs:ecosystem-node-pnpm": "user-invocable-only",
    "setup:package-lockdown:_refs:ecosystem-python-uv": "user-invocable-only",
    "setup:package-lockdown:_refs:ecosystem-rust-cargo": "user-invocable-only",
    "setup:package-lockdown:_refs:incident-response": "user-invocable-only",
    "setup:package-lockdown:_refs:pre-install-checklist": "user-invocable-only",
    "project:audit": "user-invocable-only",
    "project:new": "user-invocable-only",
    "project:_refs:pillars": "user-invocable-only",
    "project:_refs:orchestration": "user-invocable-only",
    "research:execute": "user-invocable-only",
    "convert-file": "user-invocable-only",
    "audit-usage": "user-invocable-only",
    "autonomous-mode": "user-invocable-only",
    "budget-adjust": "user-invocable-only",
    "yt-reference": "user-invocable-only",
    "ebacon:case-test-instructions": "user-invocable-only",
    "obsidian:factory": "user-invocable-only",
    "obsidian:notify": "user-invocable-only",
    "obsidian:skill-tracker": "user-invocable-only",
    "obsidian:investigate": "user-invocable-only",
    "init": "off",
    "review": "off",
    "security-review": "off",
    "keybindings-help": "off",
    "fewer-permission-prompts": "off",
    "deep-research": "off"
  },
  "hooks": {
    "Notification": [
      {
        "matcher": "permission_prompt|elicitation_dialog",
        "hooks": [
          {
            "type": "command",
            "command": "if command -v osascript &>/dev/null; then osascript -e 'display notification \"Claude needs your attention!\" with title \"Claude Code\"'; elif command -v powershell.exe &>/dev/null; then powershell.exe -Command \"[void][System.Reflection.Assembly]::LoadWithPartialName('System.Windows.Forms'); [System.Windows.Forms.MessageBox]::Show('Claude needs your attention!','Claude Code')\"; else printf '\\a'; fi"
          },
          {
            "type": "command",
            "command": "if command -v osascript &>/dev/null; then TTY=$(ps -o tty= -p $PPID | tr -d ' ') && printf '\\a' > \"/dev/$TTY\"; else printf '\\a'; fi"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if command -v osascript &>/dev/null; then TTY=$(ps -o tty= -p $PPID | tr -d ' ') && printf '\\a' > \"/dev/$TTY\"; else printf '\\a'; fi"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /Users/derek/.local/share/fnm/node-versions/v24.15.0/installation/bin/node)\" \"$HOME/.claude/hooks/subagent-gate.js\"",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/augment-skill.sh\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /Users/derek/.local/share/fnm/node-versions/v24.15.0/installation/bin/node)\" \"$HOME/.claude/hooks/subagent-gate.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(command -v node || echo /Users/derek/.local/share/fnm/node-versions/v24.15.0/installation/bin/node)\" \"$HOME/.claude/hooks/subagent-gate.js\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$HOME/.claude/hooks/sync-theme.sh\""
          },
          {
            "type": "command",
            "command": "\"$(command -v node || echo /Users/derek/.local/share/fnm/node-versions/v24.15.0/installation/bin/node)\" \"$HOME/.claude/hooks/check-hook-wiring.js\"",
            "timeout": 5
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash \"$HOME/.claude/scripts/statusline-command.sh\""
  },
  "enabledPlugins": {
    "swift-lsp@claude-plugins-official": false,
    "playwright@claude-plugins-official": true,
    "csharp-lsp@claude-plugins-official": false,
    "php-lsp@claude-plugins-official": true,
    "code-review@claude-plugins-official": false,
    "firecrawl@claude-plugins-official": false,
    "pm-toolkit@pm-skills": false,
    "pm-product-strategy@pm-skills": false,
    "pm-product-discovery@pm-skills": false,
    "pm-market-research@pm-skills": false,
    "pm-data-analytics@pm-skills": false,
    "pm-marketing-growth@pm-skills": false,
    "pm-go-to-market@pm-skills": false,
    "pm-execution@pm-skills": false,
    "splunk-mcp-plugin@tag-claude-plugins": true,
    "viper-stage-plugin@tag-claude-plugins": true,
    "vercel@claude-plugins-official": true,
    "warp@claude-code-warp": true
  },
  "extraKnownMarketplaces": {
    "cli-anything": {
      "source": {
        "source": "github",
        "repo": "HKUDS/CLI-Anything"
      }
    },
    "pm-skills": {
      "source": {
        "source": "github",
        "repo": "phuryn/pm-skills"
      }
    },
    "tag-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "TAGEmployerServices/claude-plugins"
      }
    },
    "claude-code-warp": {
      "source": {
        "source": "github",
        "repo": "warpdotdev/claude-code-warp"
      }
    }
  },
  "effortLevel": "xhigh",
  "autoUpdatesChannel": "latest",
  "tui": "fullscreen",
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "light",
  "autoCompactEnabled": false,
  "terminalOutputLimit": 150000,
  "disableTelemetry": true,
  "disableErrorReporting": true,
  "disableFeedbackDisplay": true,
  "autoCompactThreshold": 75
}
